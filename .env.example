# ─────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase)
# Format: postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase API Config
PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-publishable-or-anon-key"


# ─────────────────────────────────────────────────────────────
# EMAIL SERVICE (Nodemailer — konfigurasi dikelola via Admin UI)
# ─────────────────────────────────────────────────────────────
# Secret key untuk mengenkripsi/dekripsi SMTP password yang tersimpan di DB.
# Ganti dengan string random yang panjang & unik di production!
EMAIL_SECRET="ganti-ini-dengan-string-random-yang-panjang-di-production"

# ─────────────────────────────────────────────────────────────
# APP CONFIG
# ─────────────────────────────────────────────────────────────
# URL publik aplikasi — digunakan untuk membangun link reset password
# di email (contoh: https://nlc.sekolah.sch.id)
PUBLIC_APP_URL="http://localhost:5173"

# ─────────────────────────────────────────────────────────────
# GOOGLE OAUTH (opsional — untuk fitur Login dengan Google)
# ─────────────────────────────────────────────────────────────
# Dapatkan dari: https://console.cloud.google.com/
# Aktifkan "Google+ API" / "People API" dan buat OAuth 2.0 Client ID
# Redirect URI: {PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
